# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_grief

# Embeddings via OpenRouter's free NVIDIA Nemotron embedding model
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free

# LLM chat completion via Groq's OpenAI-compatible endpoint
GROQ_API_KEY=gsk_REPLACE_ME
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Voice cloning via Fish Audio's native API (OpenRouter has no cloning
# endpoint). Get a free key at https://fish.audio/app/api-keys/
FISH_AUDIO_API_KEY=REPLACE_ME
FISH_AUDIO_BASE_URL=https://api.fish.audio

# TTS synthesis via OpenRouter's free Fish Audio S2.1 Pro model (reuses
# OPENROUTER_API_KEY above). The ":free" suffix is required.
TTS_BASE_URL=https://openrouter.ai/api/v1
TTS_MODEL=fish-audio/s2.1-pro-free:free

# Speech-to-text
DEEPGRAM_API_KEY=REPLACE_ME

# CORS: comma-separated allowlist of frontend origins
FRONTEND_ORIGINS=http://localhost:5173

# Object storage (MinIO, private bucket) for voice samples + generated reply
# audio. Defaults match docker-compose.yml's minio service — change the
# credentials in both places together if you adjust them.
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=rag-grief-storage
MINIO_SECURE=false

# Auth: JWT secret for signing session tokens. Generate your own with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Never reuse the example value below or commit a real secret.
JWT_SECRET=REPLACE_ME_WITH_A_GENERATED_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60
# Cookies only sent over HTTPS (or http://localhost, which browsers treat as
# secure). Only set to false for a non-TLS deployment, which you shouldn't do.
AUTH_COOKIE_SECURE=true

# The one admin account, created/kept in sync with these values on every
# backend startup. Admin status is never granted through signup — only
# this account can approve new users and access /admin. Change the
# password here (and restart) to rotate it.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_ME_WITH_A_STRONG_PASSWORD
