# Copy to .env. Never commit real secrets.
MC_DB_PASSWORD=memory
MC_DB_PORT=5433
MC_BACKEND_PORT=8100
MC_FRONTEND_PORT=3100

# Backend (read with MC_ prefix). Outside development the app refuses the default secret.
MC_ENVIRONMENT=development
MC_JWT_SECRET=change-me-to-a-long-random-string
MC_DATABASE_URL=postgresql+psycopg://memory:memory@localhost:5433/memory_companion
MC_REFRESH_COOKIE_SECURE=false   # set true behind HTTPS

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8100
