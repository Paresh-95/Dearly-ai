# Copy to .env. Never commit real secrets.
MC_DB_PASSWORD=memory
MC_DB_PORT=5433
MC_BACKEND_PORT=8100
MC_FRONTEND_PORT=3100

# Backend (read with MC_ prefix). Outside development the app refuses the default secret.
MC_ENVIRONMENT=development
MC_JWT_SECRET=change-me-to-a-long-random-string
MC_DATABASE_URL=postgresql+psycopg://memory:memory@localhost:5433/memory_companion
MC_REFRESH_COOKIE_SECURE=false   # set true behind HTTPS

# Object storage for uploaded originals. "local" (default) writes under MC_STORAGE_LOCAL_DIR
# and needs no setup; "s3" talks to the MinIO container below (docker-compose sets this
# automatically for the backend/worker services).
MC_STORAGE_BACKEND=local
MC_STORAGE_LOCAL_DIR=./data/uploads
MC_S3_PORT=9100
MC_S3_CONSOLE_PORT=9101
MC_S3_ACCESS_KEY=minioadmin
MC_S3_SECRET_KEY=minioadmin
MC_S3_BUCKET=memory-companion

MC_MAX_UPLOAD_MB=50

# Optional. Leaving this unset is a supported state: transcription, OCR-backed candidate
# review and LLM memory-candidate extraction simply fail their ingestion job with a clear
# message instead of fabricating output. See docs/decisions/0003-provider-fallbacks.md.
MC_OPENAI_API_KEY=
MC_OPENAI_BASE_URL=https://api.openai.com/v1
MC_OPENAI_CHAT_MODEL=gpt-5-mini
MC_OPENAI_STT_MODEL=whisper-1

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8100
